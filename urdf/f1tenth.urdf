<?xml version="1.0"?>
<!-- Base Robot Description for 1:10 Scale F1TENTH Autonomous Vehicle -->
<robot name="f1tenth">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Physical inertial properties (overwritten during calibration) -->
      <mass value="3.4000"/>
      <inertia ixx="0.0150" ixy="0.0" ixz="0.0" iyy="0.0350" iyz="0.0" izz="0.0450"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.20 0.12"/>
      </geometry>
      <material name="chassis_mat">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.20 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Front Virtual Axle for Ackermann Steering -->
  <link name="front_axle_link"/>
  <joint name="front_axle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_axle_link"/>
    <origin xyz="0.1600 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Steering Actuator Revolute Joint with Calibratable Dynamics -->
  <link name="steering_link"/>
  <joint name="steering_joint" type="revolute">
    <parent link="front_axle_link"/>
    <child link="steering_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.4" upper="0.4" effort="10.0" velocity="8.0"/>
    <dynamics damping="0.0500" friction="0.0100"/>
  </joint>
</robot>
