<?xml version="1.0"?>
<sdf version="1.6">
  <model name="f1tenth_vehicle">
    <link name="base_link">
      <inertial>
        <mass>3.4000</mass>
        <inertia>
          <ixx>0.0150</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0350</iyy>
          <iyz>0.0</iyz>
          <izz>0.0450</izz>
        </inertia>
      </inertial>
    </link>
    <link name="steering_link"/>
    <joint name="steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.0500</damping>
          <friction>0.0100</friction>
        </dynamics>
      </axis>
    </joint>
  </model>
</sdf>
